#!/usr/bin/env ruby
require 'bundler/setup'
require 'bump'
require 'open3'
require_relative '../lib/env_agent/version'

# Releases env-agent at the next major, minor or patch version, or at VERSION: bumps it, checks, commits, tags, pushes and creates the GitHub release.
class Release
  BRANCH = 'master'.freeze
  VERSION_FILE = 'lib/env_agent/version.rb'.freeze
  LOCK_FILE = 'Gemfile.lock'.freeze
  INCREMENTS = %w[major minor patch].freeze

  # @param [Array<String>] argv
  def initialize(argv)
    abort('usage: bin/release major|minor|patch|VERSION') unless argv.size == 1
    @version = INCREMENTS.include?(argv.first) ? Bump::Bump.next_version(argv.first, EnvAgent::VERSION) : argv.first
  end

  def run!
    check!
    bump!
    sh('bundle', 'exec', 'rake')
    sh('gem', 'build', 'env-agent.gemspec', '--output', gem_file)
    sh('git', 'commit', '-q', '-m', "build: release #{tag}", VERSION_FILE, LOCK_FILE)
    sh('git', 'tag', '-a', tag, '-m', tag)
    sh('git', 'push', '--atomic', remote, "#{BRANCH}:#{BRANCH}", tag)
    sh('gh', 'release', 'create', tag, gem_file, '--verify-tag', '--title', tag, '--generate-notes')
    puts("released #{tag}")
  end

  private

  attr_reader :version

  # @return [String]
  def tag
    "v#{version}"
  end

  # @return [String]
  def gem_file
    "env-agent-#{version}.gem"
  end

  # @return [String]
  def remote
    @remote ||= git('config', "branch.#{BRANCH}.remote")
  end

  def check!
    abort("#{version} is not MAJOR.MINOR.PATCH") unless version.match?(/\A\d+\.\d+\.\d+\z/)
    abort("#{version} is not newer than #{EnvAgent::VERSION}") unless Gem::Version.new(version) > Gem::Version.new(EnvAgent::VERSION)
    abort("release from #{BRANCH}") unless git('branch', '--show-current') == BRANCH
    abort('commit or stash your changes first') unless git('status', '--porcelain').empty?
    abort("#{tag} already exists") unless git('tag', '--list', tag).empty?

    sh('git', 'fetch', '-q', remote, BRANCH)
    abort("#{BRANCH} is behind or has diverged from #{remote}/#{BRANCH}") unless ancestor?("#{remote}/#{BRANCH}", 'HEAD')
  end

  def bump!
    message, status = Bump::Bump.run('set', version: version, commit: false, tag: false, bundle: true)
    abort(message) unless status.zero?
  end

  # @param [String] ancestor
  # @param [String] descendant
  #
  # @return [TrueClass, FalseClass]
  def ancestor?(ancestor, descendant)
    system('git', 'merge-base', '--is-ancestor', ancestor, descendant)
  end

  # @param [Array<String>] args
  #
  # @return [String]
  def git(*args)
    out, status = Open3.capture2('git', *args)
    abort("git #{args.first} failed") unless status.success?

    out.strip
  end

  # @param [Array<String>] command
  def sh(*command)
    abort("#{command.first(2).join(' ')} failed") unless system(*command)
  end
end

Release.new(ARGV).run!
